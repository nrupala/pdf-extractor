{
 "action": {
  "default_icon": {
   "128": "icons/icon128.png",
   "16": "icons/icon16.png",
   "32": "icons/icon32.png",
   "48": "icons/icon48.png"
  },
  "default_popup": "popup.html",
  "default_title": "PDF Extractor"
 },
 "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
 },
 "description": "Extract text, structure & Word files from PDFs — entirely in your browser. Nothing is uploaded.",
 "host_permissions": [
  "https://aimlds.org/*"
 ],
 "icons": {
  "128": "icons/icon128.png",
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png"
 },
 "manifest_version": 3,
 "name": "PDF Extractor (pdfx)",
 "permissions": [
  "activeTab",
  "clipboardWrite"
 ],
 "version": "1.1.1",
 "browser_specific_settings": {
  "gecko": {
   "id": "pdfx@aimlds.org",
   "strict_min_version": "109.0"
  }
 }
}